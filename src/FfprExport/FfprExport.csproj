<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ffpr-export</AssemblyName>
    <RootNamespace>FfprExport</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version Condition="'$(Version)' == '' and Exists('$(MSBuildProjectDirectory)/../../VERSION')">$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../../VERSION').Trim())</Version>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AssetsTools.NET" Version="3.0.5" />
    <PackageReference Include="AssetsTools.NET.Cpp2IL" Version="3.0.4" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="Samboy063.LibCpp2IL" Version="2022.1.0-pre-release.19" />
    <InternalsVisibleTo Include="FfprExport.Tests" />
    <EmbeddedResource Include="../../known-builds.json" LogicalName="FfprExport.known-builds.json" />
  </ItemGroup>
  <Target Name="EmbedGitCommitMetadata" BeforeTargets="GetAssemblyAttributes">
    <Exec Condition="'$(FfprGitCommit)' == ''"
          Command="git rev-parse --short=12 HEAD"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          IgnoreStandardErrorWarningFormat="true"
          StandardErrorImportance="Low"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="FfprGitCommit" />
      <Output TaskParameter="ExitCode" PropertyName="FfprGitExitCode" />
    </Exec>
    <PropertyGroup>
      <FfprGitCommit Condition="'$(FfprGitExitCode)' != '' and '$(FfprGitExitCode)' != '0'">unknown</FfprGitCommit>
      <FfprGitCommit Condition="'$(FfprGitCommit)' == ''">unknown</FfprGitCommit>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Include="GitCommit" Value="$(FfprGitCommit)" />
    </ItemGroup>
  </Target>
</Project>
